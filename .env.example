# ==============================================================================
# SPASHTA (स्पष्ट) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the root directory and update with your own keys:
# cp .env.example .env
# ==============================================================================

# 1. SPASHTA API Authentication
SPASHTA_API_KEY=spashta-secret-key-2026

# 2. Multilingual & Batch Translation APIs (Pick Any / Optional)
# Google Gemini API Key (Gemini 1.5 Flash)
# Get a free key at: https://aistudio.google.com/app/apikey
# Free Tier Limits: 15 Requests/Min, 1,500 Requests/Day (100% Free)
GEMINI_API_KEY=

# 3. AI Copilot / LLM Engine (Optional)
# Groq Cloud API Key (Llama 3.3 70B Versatile)
# Get a free key at: https://console.groq.com/keys
# Free Tier Limits: 30 Requests/Min, 14,400 Requests/Day
GROQ_API_KEY=

# 4. Database & Storage
# If left empty, SPASHTA automatically defaults to local SQLite sqlite:///./spashta_audit.db
DATABASE_URL=

# 5. Server & CORS Settings
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,https://spashta.vercel.app,https://spashtaa.vercel.app
